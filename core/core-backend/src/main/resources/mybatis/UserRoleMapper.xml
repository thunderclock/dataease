<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.dataease.user.dao.UserRoleMapper">

    <!-- 用户角色关联结果映射 -->
    <resultMap id="BaseResultMap" type="io.dataease.user.entity.UserRole">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="user_id" property="userId" jdbcType="BIGINT"/>
        <result column="role_id" property="roleId" jdbcType="BIGINT"/>
        <result column="create_time" property="createTime" jdbcType="BIGINT"/>
    </resultMap>

    <!-- 删除用户的所有角色 -->
    <delete id="deleteByUserId">
        DELETE FROM core_user_role WHERE user_id = #{userId}
    </delete>

    <!-- 批量插入用户角色 -->
    <insert id="batchInsert">
        INSERT IGNORE INTO core_user_role (user_id, role_id, create_time)
        VALUES
        <foreach collection="roleIds" item="roleId" separator=",">
            (#{userId}, #{roleId}, #{createTime})
        </foreach>
    </insert>

</mapper>
